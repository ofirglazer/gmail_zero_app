# gmail_zero_app — environment configuration template
#
# SECURITY: This file contains sensitive configuration.
#   - Copy this file to .env and fill in the values
#   - The .env file is gitignored and must NEVER be committed to version control
#   - Restrict file permissions to the application user only (chmod 600 on Unix, ACL on Windows)
#   - Never share the .env file or its contents with others
#
# See docs/setup_production.md for detailed setup instructions.

# ═══════════════════════════════════════════════════════════════════════════════
# RUNTIME ENVIRONMENT
# ═══════════════════════════════════════════════════════════════════════════════

# Options: production | demo
#   - production: Uses real Gmail API (requires OAuth credentials)
#   - demo:       Uses synthetic mock data (no credentials required)
# For production use, set this to 'production'.
GMAIL_ZERO_ENV=demo

# ═══════════════════════════════════════════════════════════════════════════════
# FLASK WEB SERVER
# ═══════════════════════════════════════════════════════════════════════════════

# SECURITY: Generate a unique, random secret key for session encryption.
# This key is used to sign all session cookies. If compromised, all sessions are vulnerable.
#
# Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
#
# For production: MUST be a 64-character hex string (32 bytes)
# For demo mode: Any string works, but should still be random
#
# If you change this in production, all existing sessions become invalid (users must log in again).
GMAIL_ZERO_SECRET_KEY=replace-this-with-a-strong-random-secret

# Port the Flask server listens on.
# The application always binds to 127.0.0.1 (local access only) for security.
# If you need external access, run behind a reverse proxy with HTTPS.
GMAIL_ZERO_PORT=5000

# Enable debug mode (Flask auto-reload, detailed error pages).
# SECURITY: MUST be false in production. Debug mode exposes internal details and allows code execution.
# Only set to true during local development.
GMAIL_ZERO_DEBUG=false

# ═══════════════════════════════════════════════════════════════════════════════
# GMAIL API CREDENTIALS & DATABASE PATHS
# ═══════════════════════════════════════════════════════════════════════════════

# SQLite database file path (local storage for messages and snapshots).
# Paths can be absolute (C:\data\...) or relative to the project root.
# SECURITY: Restrict file permissions to the application user only.
GMAIL_ZERO_DB_PATH=data/gmail_zero_app.db

# Path to credentials.json (downloaded from Google Cloud Console).
# SECURITY: This file contains your OAuth client secret.
#   - Keep it private and secure
#   - Do not commit to version control
#   - Do not share with others
GMAIL_ZERO_CREDENTIALS_PATH=data/credentials/credentials.json

# Path to the OAuth token file (generated on first authorization).
# SECURITY: This file contains your Gmail access token.
#   - The application creates this automatically on first run
#   - Keep it private and secure
#   - Never share with others
#   - If compromised, revoke at https://myaccount.google.com/security
GMAIL_ZERO_TOKEN_PATH=data/credentials/token.json

# Path to the labels configuration file (defines custom labels and workflows).
GMAIL_ZERO_LABELS_CONFIG_PATH=config/labels.toml

# ═══════════════════════════════════════════════════════════════════════════════
# GMAIL SYNC BEHAVIOR
# ═══════════════════════════════════════════════════════════════════════════════

# Batch size for message fetching during full sync (messages per API call).
# Higher values = fewer API calls but larger request/response payloads.
# Lower values = more API calls but smaller payloads.
# Valid range: 1–500 (Gmail API limit).
# Default: 100 is a good balance for most users.
# Adjust if sync is slow or times out frequently.
GMAIL_ZERO_SYNC_BATCH_SIZE=100

# Milliseconds to pause between API batch calls (rate limiting).
# Prevents hitting Gmail API rate limits.
# Recommended range: 10–100 ms depending on your quota usage.
# If you see rate limit errors, increase this value.
GMAIL_ZERO_SYNC_RATE_LIMIT_DELAY_MS=50

# ═══════════════════════════════════════════════════════════════════════════════
# MESSAGE SIZE THRESHOLDS
# ═══════════════════════════════════════════════════════════════════════════════

# Messages above these byte sizes are flagged in the "Size Reduction" workflow.
# These help identify large attachments and messages to delete.

# Threshold for "Large" messages (yellow flag).
# Default: 5 MB (5242880 bytes)
GMAIL_ZERO_LARGE_MESSAGE_THRESHOLD_BYTES=5242880

# Threshold for "Very Large" messages (red flag).
# Default: 15 MB (15728640 bytes)
GMAIL_ZERO_VERY_LARGE_MESSAGE_THRESHOLD_BYTES=15728640

# ═══════════════════════════════════════════════════════════════════════════════
# DASHBOARD GRAPHS & ANALYTICS
# ═══════════════════════════════════════════════════════════════════════════════

# Number of days of history to display on the dashboard progress graphs.
# Larger values = more historical context but slower initial load.
# Recommended: 30 or 90 days.
GMAIL_ZERO_GRAPH_HISTORY_DAYS=30

# ═══════════════════════════════════════════════════════════════════════════════
# THREAD RESOLUTION TRACKING
# ═══════════════════════════════════════════════════════════════════════════════

# Threads older than this threshold are flagged as "unresolved" in the Sent workflow.
# This helps identify follow-up actions that are stale.
# Default: 30 days
GMAIL_ZERO_OLD_THREAD_THRESHOLD_DAYS=30

# Threads older than this threshold are flagged as "very old unresolved".
# Default: 90 days
GMAIL_ZERO_VERY_OLD_THREAD_THRESHOLD_DAYS=90

# ═══════════════════════════════════════════════════════════════════════════════
# OPTIONAL: ADVANCED SETTINGS
# ═══════════════════════════════════════════════════════════════════════════════

# These settings are optional and default to sensible values.
# Only change them if you have a specific reason to do so.

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# Default: WARNING (less verbose in production)
# Set to DEBUG only during development troubleshooting.
# GMAIL_ZERO_LOG_LEVEL=WARNING

# Enable scheduled background sync (true/false).
# Default: true (automatic sync runs daily)
# Set to false to disable automatic sync (manual sync only).
# GMAIL_ZERO_ENABLE_SCHEDULER=true

# Hour (0-23 UTC) at which to run the daily full sync.
# Default: 3 (3 AM UTC, avoiding peak usage hours)
# GMAIL_ZERO_SYNC_FULL_HOUR=3

# Interval (minutes) for incremental syncs.
# Default: 30 (sync every 30 minutes)
# GMAIL_ZERO_SYNC_INCREMENTAL_INTERVAL=30
